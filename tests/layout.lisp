(in-package #:clermaid)

(defun layout-tests ()
  "Exercise graph geometry, route isolation, directions, and terminal cell bounds."
  (let ((checks 0))
    (labels ((check (value)
               (incf checks)
               (assert value))

             (locate-label (label rows)
               (loop for row in rows for y from 0
                     for x = (search label row)
                     when x return (cons x y))))
      (dolist (direction '("LR" "RL" "TD" "BT"))
        (let* ((source (format nil "flowchart ~a~%Alpha --> Omega" direction))
               (rows   (render-mermaid source))
               (a      (locate-label "Alpha" rows))
               (b      (locate-label "Omega" rows)))
          (check (and a b))
          (check (cond ((string= direction "LR")
                        (< (first a) (first b)))
                       ((string= direction "RL")
                        (> (first a) (first b)))
                       ((string= direction "TD")
                        (< (rest a) (rest b)))
                       (t
                        (> (rest a) (rest b)))))))
      (dolist (body '("A --> B" "A --> B; B --> A" "A --> A"
                      "A --> B; A --> B; B --> C; C --> A"
                      "A --> B; A --> C; B --> D; C --> D; E"))
        (let ((diagram (diagram-parse :flowchart (format nil "flowchart LR~%~a" body))))
          (multiple-value-bind (placements width height) (graph--place-nodes diagram t)
            (let ((canvas (graph--canvas width height))
                  (ports  (graph--assign-edge-ports diagram placements)))
              (graph--reserve-edge-approaches canvas diagram placements ports)
              (dolist (placement placements)
                (loop for row in (graph-placement-rows placement)
                      for y from (graph-placement-y placement)
                      do (graph--put-text canvas (graph-placement-x placement) y row :blocked t)))
              (dolist (edge (graph-edges diagram))
                (let ((route (graph--draw-edge canvas edge :placements placements
                                               :horizontal t :unicode t :port-counts ports)))
                  (check (> (length route) 2))
                  (check (loop for (a b) on route while b
                               always (= 1 (+ (abs (- (first a) (first b)))
                                              (abs (- (rest a) (rest b)))))))
                  (check (every (lambda (cell)
                                  (zerop (aref (graph-canvas-blocked canvas)
                                               (rest cell) (first cell))))
                                (butlast (rest route))))))))))
      (dolist (direction '("TD" "BT" "LR" "RL"))
        (dolist (body '("A; B; C; D; A --> D; B --> C"
                        "A --> B; A --> C; B --> D; C --> D"))
          (let ((rows (render-mermaid (format nil "flowchart ~a~%~a" direction body))))
            (check (notany (lambda (row) (find #\┼ row)) rows))
            (check (every (lambda (label) (locate-label label rows)) '("A" "B" "C" "D"))))))
      (let ((canvas (graph--canvas 9 7)))
        (loop for y from 1 below 5
              do (graph--connect canvas (cons 4 y) (cons 4 (1+ y))))
        (let ((route (graph--route canvas (cons 1 3) (cons 7 3))))
          (check (> (length route) 7))
          (check (every (lambda (point)
                          (zerop (aref (graph-canvas-lines canvas) (rest point) (first point))))
                        route))))
      (let* ((canvas   (graph--canvas 9 7))
             (approach (cons 4 3)))
        (setf (gethash approach (graph-canvas-reserved canvas)) t)
        (let ((route (graph--route canvas (cons 1 3) (cons 7 3))))
          (check (not (member approach route :test #'equal)))
          (loop for (point next) on route while next
                do (graph--connect canvas point next)))
        (check (zerop (aref (graph-canvas-lines canvas) 3 4)))
        (check (equal approach (first (graph--route canvas approach (cons 4 0)))))
        (graph--connect canvas approach (cons 5 3))
        (dolist (endpoints (list (list approach (cons 0 0)) (list (cons 0 0) approach)))
          (check (handler-case (progn (graph--route canvas (first endpoints) (second endpoints)) nil)
                   (resource-limit-exceeded () t)))))
      (dolist (source (list (format nil "flowchart LR~%A[東京] -->|café| B[é]")
                            (format nil "stateDiagram-v2~%[*] --> Ready~%Ready --> [*]")
                            (format nil "classDiagram~%Animal <|-- Dog~%class Dog {~%+String name~%+bark()~%}")
                            (format nil "erDiagram~%USER ||--o{ ORDER : places")))
        (dolist (unicode '(t nil))
          (let ((rows (render-mermaid source :width 120 :unicode unicode)))
            (check (every (lambda (row) (<= (text-cell-width row) 120)) rows))
            (check (equal rows (render-mermaid source :width 120 :unicode unicode))))))
      (let ((rows (render-mermaid (format nil "flowchart LR~%A --> B") :unicode nil)))
        (check (every (lambda (row) (every (lambda (c) (< (char-code c) 128)) row)) rows))))
    checks))
