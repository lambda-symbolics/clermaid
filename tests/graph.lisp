(in-package #:clermaid)

(defun graph-test-source (&rest lines)
  (format nil "~{~a~^~%~}" lines))

(defun graph-tests ()
  "Run parser/model checks for supported graph diagram families."
  (let ((checks 0))
    (labels ((check (value)
               (unless value (error "Graph check failed at ~d." checks))
               (incf checks))

             (fails (thunk)
               (handler-case (progn (funcall thunk) nil)
                 (mermaid-error () t))))
      (let ((diagram (diagram-parse :flowchart
                                    (graph-test-source
                                     "%% comment" "flowchart LR"
                                     "A[Start] -->|go| B{Ready?}"
                                     "B -.-> C[Done]"))))
        (check (eq (graph-direction diagram) :lr))
        (check (= (length (graph-nodes diagram)) 3))
        (check (= (length (graph-edges diagram)) 2))
        (check (string= (graph-node-id (first (graph-nodes diagram))) "A"))
        (check (string= (graph-node-label (first (graph-nodes diagram))) "Start"))
        (check (eq (graph-node-shape (second (graph-nodes diagram))) :diamond))
        (check (string= (graph-edge-label (first (graph-edges diagram))) "go"))
        (check (string= (graph-edge-relation (second (graph-edges diagram))) "-.->")))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart" "A-->B-->C"))))
        (check (eq (graph-direction diagram) :td))
        (check (= (length (graph-edges diagram)) 2)))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart LR" "a-->A" "A[upper]"))))
        (check (= (length (graph-nodes diagram)) 2))
        (check (string= (graph-node-id (first (graph-nodes diagram))) "a"))
        (check (string= (graph-node-label (second (graph-nodes diagram))) "upper")))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart LR" "A-->B & C" "D & E-->F"))))
        (check (= (length (graph-edges diagram)) 4))
        (check (= (length (graph-nodes diagram)) 6)))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart LR" "A---B" "C -.- D"))))
        (check (eq (graph-edge-kind (first (graph-edges diagram))) :line))
        (check (eq (graph-edge-kind (second (graph-edges diagram))) :dotted-line)))
      (let ((diagram (diagram-parse :flowchart
                                    (graph-test-source "flowchart LR"
                                                       "A[\"x ; & y\"]-->B(rounded)"
                                                       "C([stadium])-->D{decision}"))))
        (check (string= (graph-node-label (first (graph-nodes diagram))) "x ; & y"))
        (check (eq (graph-node-shape (second (graph-nodes diagram))) :rounded))
        (check (eq (graph-node-shape (third (graph-nodes diagram))) :stadium))
        (check (eq (graph-node-shape (fourth (graph-nodes diagram))) :diamond)))
      (let ((diagram (diagram-parse :state
                                    (graph-test-source "stateDiagram-v2" "direction LR"
                                                       "[*] --> Idle" "state \"Busy now\" as Busy"
                                                       "Idle --> Busy : begin:now" "Busy --> [*]"))))
        (check (eq (graph-direction diagram) :lr))
        (check (= (length (graph-edges diagram)) 3))
        (check (eq (graph-node-shape (first (graph-nodes diagram))) :initial))
        (check (eq (graph-node-shape (second (graph-nodes diagram))) :rectangle)))
      (let ((diagram (diagram-parse :class
                                    (graph-test-source "classDiagram" "class Animal {"
                                                       "+name : string" "}" "Animal <|-- Duck"))))
        (check (= (length (graph-edges diagram)) 1))
        (check (eq (graph-edge-kind (first (graph-edges diagram))) :inheritance))
        (check (= (length (graph-node-members (first (graph-nodes diagram)))) 1)))
      (let ((diagram (diagram-parse :er (graph-test-source "erDiagram" "USER ||--o{ ORDER : places"))))
        (check (= (length (graph-edges diagram)) 1))
        (check (string= (graph-node-id (graph-edge-to (first (graph-edges diagram)))) "ORDER"))
        (check (string= (graph-edge-label (first (graph-edges diagram))) "places"))
        (check (string= (graph-edge-relation (first (graph-edges diagram))) "||--o{"))
        (check (eq (graph-edge-kind (first (graph-edges diagram))) :association)))
      (dolist (bad (list (graph-test-source "flowchart LR" "A[bad")
                         (graph-test-source "flowchart LR" "A-->")
                         (graph-test-source "flowchart LR" "subgraph X")
                         (graph-test-source "flowchart LR" "style A fill:red")))
        (check (fails (lambda () (diagram-parse :flowchart bad)))))
      (check (fails (lambda ()
                      (diagram-parse :flowchart
                                     (make-string (1+ *maximum-source-length*)
                                                  :initial-element #\A)))))
      (check (fails (lambda () (diagram-parse :state (graph-test-source "stateDiagram" "par foo")))))
      (check (fails (lambda () (diagram-parse :er (graph-test-source "erDiagram" "A ||-- B")))))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart LR" "A --- B --> C -.-> D"))))
        (check (equal '(:line :arrow :dotted) (mapcar #'graph-edge-kind (graph-edges diagram)))))
      (let ((diagram (diagram-parse :flowchart (graph-test-source "flowchart LR" "A[\"text --> text\"] --> B"))))
        (check (= 1 (length (graph-edges diagram))))
        (check (string= "text --> text" (graph-node-label (first (graph-nodes diagram))))))
      (dolist (body '("class A {" "class A { ignored" "class A {; } garbage"))
        (check (fails (lambda () (diagram-parse :class (graph-test-source "classDiagram" body))))))
      (let ((diagram (diagram-parse :er (graph-test-source "erDiagram" "USER {" "string name" "}" "USER }|..|{ ORDER : places"))))
        (check (= 1 (length (graph-node-members (first (graph-nodes diagram))))))
        (check (string= "}|..|{" (graph-edge-relation (first (graph-edges diagram))))))
      checks)))
