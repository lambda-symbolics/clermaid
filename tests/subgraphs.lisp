(in-package #:clermaid)

(defun subgraph-tests ()
  "Check nested containment, scope geometry, routing, labels, and typed limits."
  (let ((checks 0))
    (labels ((signals-p (type thunk)
               (handler-case (progn (funcall thunk) nil)
                 (error (condition) (typep condition type))))

             (check (value) (incf checks) (assert value))

             (parse (&rest lines) (diagram-parse :flowchart (apply #'graph-test-source lines)))

             (node (diagram id) (find id (graph-nodes diagram) :key #'graph-node-id :test #'string=))

             (inside-p (child parent)
               (and (> (graph-placement-x child) (graph-placement-x parent))
                    (> (graph-placement-y child) (+ 1 (graph-placement-y parent)))
                    (< (+ (graph-placement-x child) (graph-placement-width child))
                       (+ (graph-placement-x parent) (graph-placement-width parent)))
                    (< (+ (graph-placement-y child) (graph-placement-height child))
                       (+ (graph-placement-y parent) (graph-placement-height parent)))))

             (separate-p (a b)
               (or (<= (+ (graph-placement-x a) (graph-placement-width a)) (graph-placement-x b))
                   (<= (+ (graph-placement-x b) (graph-placement-width b)) (graph-placement-x a))
                   (<= (+ (graph-placement-y a) (graph-placement-height a)) (graph-placement-y b))
                   (<= (+ (graph-placement-y b) (graph-placement-height b)) (graph-placement-y a)))))
      (let* ((diagram (parse "flowchart LR" "subgraph outer[\"Outer ; & title\"]"
                             "direction TD" "A[Alpha]" "subgraph inner[東京é]" "B[Beta]"
                             "end" "A-->B" "end" "subgraph other" "C[Gamma]" "end"
                             "B-->|cross|C" "outer-->other"))
             (outer (node diagram "outer")) (inner (node diagram "inner")))
        (check (string= (graph-node-label outer) "Outer ; & title"))
        (check (eq (graph-node-parent inner) outer))
        (check (eq (graph-node-parent (node diagram "A")) outer))
        (check (eq (graph-node-parent (node diagram "B")) inner))
        (check (eq (graph-subgraph-direction outer) :td))
        (check (= (length (graph-edges diagram)) 3))
        (check (eq (graph-edge-from (third (graph-edges diagram))) outer))
        (dolist (unicode '(t nil))
          (multiple-value-bind (placements width height) (graph--place-subgraphs diagram unicode)
            (check (plusp width)) (check (plusp height))
            (dolist (placement placements)
              (let ((parent (graph-node-parent (graph-placement-node placement))))
                (when parent
                  (check (inside-p placement (find parent placements :key #'graph-placement-node))))))
            (loop for tail on placements for a = (first tail)
                  do (dolist (b (rest tail))
                       (when (eq (graph-node-parent (graph-placement-node a))
                                 (graph-node-parent (graph-placement-node b)))
                         (check (separate-p a b)))))
            (let ((canvas (graph--canvas width height))
                  (ports  (graph--assign-edge-ports diagram placements)))
              (graph--reserve-edge-approaches canvas diagram :placements placements :ports ports)
              (dolist (placement placements)
                (if (typep (graph-placement-node placement) 'graph-subgraph)
                    (graph--draw-subgraph canvas placement)
                    (graph--draw-node canvas placement)))
              (dolist (edge (graph-edges diagram))
                (let ((route (graph--draw-edge canvas edge :placements placements
                                               :horizontal t :unicode unicode :port-counts ports)))
                  (check (equal (first route) (gethash (list edge :from) ports)))
                  (check (equal (first (last route)) (gethash (list edge :to) ports)))
                  (check (loop for point in (butlast (rest route))
                               always (zerop (aref (graph-canvas-blocked canvas)
                                                   (rest point) (first point)))))
                  (when (string= (graph-node-id (graph-edge-from edge)) "B")
                    (check (some (lambda (point)
                                   (some (lambda (placement)
                                           (and (typep (graph-placement-node placement) 'graph-subgraph)
                                                (or (= (first point) (graph-placement-x placement))
                                                    (= (first point) (+ (graph-placement-x placement)
                                                                      (graph-placement-width placement) -1)))))
                                         placements)) route)))))))
          (multiple-value-bind (rows semantic) (diagram-render diagram :width 200 :unicode unicode)
            (check (some (lambda (row) (search "東京é" row)) rows))
            (check (some (lambda (row) (search "Outer ; & title" row)) rows))
            (check (every (lambda (row) (<= (text-cell-width row) 200)) rows))
            (check (equal rows (mapcar (lambda (row) (apply #'concatenate 'string (mapcar #'rest row))) semantic)))
            (check (some (lambda (row) (find :mermaid-box row :key #'first)) semantic))
            (check (some (lambda (row) (find :mermaid-arrow row :key #'first)) semantic)))))
      (dolist (direction '("LR" "RL" "TD" "TB" "BT"))
        (let* ((diagram    (parse "flowchart LR" "subgraph G" (format nil "direction ~a" direction)
                                  "A-->B" "end" "X-->G" "B-->Y"))
               (placements (graph--place-subgraphs diagram t))
               (a          (find (node diagram "A") placements :key #'graph-placement-node))
               (b          (find (node diagram "B") placements :key #'graph-placement-node)))
          (check (case (graph-direction-from-text direction)
                   (:lr
                    (< (graph-placement-x a) (graph-placement-x b)))
                   (:rl
                    (> (graph-placement-x a) (graph-placement-x b)))
                   (:bt
                    (> (graph-placement-y a) (graph-placement-y b)))
                   (otherwise
                    (< (graph-placement-y a) (graph-placement-y b)))))
          (check (consp (diagram-render diagram :width 200)))))
      (dolist (title '("Bare title" "\"Quoted title\"" "S[Spaced label]" "S [\"Quoted label\"]"))
        (let ((diagram (parse "graph TD" (format nil "subgraph ~a" title) "A" "end")))
          (check (= (length (graph-nodes diagram)) 2))
          (check (consp (diagram-render diagram)))))
      (let* ((diagram (parse "flowchart TD" (format nil "subgraph~cG[Tabbed group]" #\Tab)
                             (format nil "direction~cLR" #\Tab) "A-->B" "end"))
             (group   (node diagram "G")))
        (check (typep group 'graph-subgraph))
        (check (string= (graph-node-label group) "Tabbed group"))
        (check (eq (graph-node-parent (node diagram "A")) group))
        (check (eq (graph-subgraph-direction group) :lr))
        (check (some (lambda (row) (search "Tabbed group" row))
                     (diagram-render diagram :width 200))))
      ;; Parsing must reject a group endpoint connected to any descendant.
      ;; Also check group endpoints referenced before their declarations.
      (dolist (descendant '("A" "H" "I" "B"))
        (dolist (reverse-p '(nil t))
          (dolist (forward-p (if (member descendant '("H" "I") :test #'string=) '(nil t) '(nil)))
            (let* ((edge   (if reverse-p (format nil "~a-->G" descendant)
                              (format nil "G-->~a" descendant)))
                   (scopes '("subgraph G" "A" "subgraph H" "subgraph I" "B"
                             "end" "end" "end"))
                   (lines  (if forward-p (cons edge scopes) (append scopes (list edge)))))
              (check (signals-p 'invalid-diagram
                                (lambda () (apply #'parse "flowchart TD" lines))))))))
      ;; Group endpoints in separate branches remain routable in both directions.
      (dolist (edge '("G-->H" "H-->G" "G-->J" "J-->G" "G-->B" "B-->G"))
        (let ((diagram (parse "flowchart TD" "subgraph G" "A" "end"
                              "subgraph H" "subgraph J" "B" "end" "end" edge)))
          (dolist (unicode '(t nil))
            (check (consp (diagram-render diagram :width 200 :unicode unicode))))))
      (dolist (lines '(("end") ("subgraph G" "A") ("subgraph" "end")
                       ("subgraph G" "end" "subgraph G" "end")
                       ("subgraph G" "direction" "end")
                       ("subgraph G[x] trailing" "end")))
        (check (signals-p 'invalid-diagram
                          (lambda () (apply #'parse "flowchart TD" lines)))))
      (check (signals-p 'unsupported-syntax
                        (lambda () (parse "flowchart TD" "subgraph G" "direction XX" "end"))))
      (let ((*maximum-subgraph-depth* 2))
        (check (signals-p 'resource-limit-exceeded
                          (lambda () (parse "flowchart TD" "subgraph A" "subgraph B" "subgraph C")))))
      (let ((*maximum-nodes* 2))
        (check (signals-p 'resource-limit-exceeded
                          (lambda () (parse "flowchart TD" "subgraph G" "A-->B" "end")))))
      (let* ((diagram  (parse "flowchart TD" "subgraph G" "A" "end"))
             (required (nth-value 1 (graph--place-subgraphs diagram t))))
        (check (signals-p 'diagram-too-wide
                          (lambda () (diagram-render diagram :width (1- required)))))
        (check (consp (diagram-render diagram :width required)))
        (let ((*maximum-output-rows* 8))
          (check (signals-p 'resource-limit-exceeded (lambda () (diagram-render diagram))))))
      (dolist (lines '(("subgraph Empty" "end")
                       ("X-->G" "subgraph G" "A" "end")
                       ("subgraph G" "A-->A" "end" "G-->G")
                       ("subgraph A" "X" "end" "subgraph B" "Y" "end" "X-->Y" "Y-->X")))
        (check (consp (diagram-render (apply #'parse "flowchart TD" lines) :width 200)))))
    checks))
