(in-package #:clermaid)

(defun sequence-tests ()
  "Exercise sequence parsing, validation, layout, and terminal-cell handling."
  (let ((checks 0))
    (flet ((ok (value)
             (assert value () "Sequence assertion ~d failed." (1+ checks))
             (incf checks))
           (signals (type thunk)
             (handler-case (progn (funcall thunk) nil)
               (mermaid-error (condition) (typep condition type)))))
      (let* ((source (format nil "sequenceDiagram~%participant A as Alice~%participant B as Bob~%A->>B: hello~%B-->>A: reply~%A->A: self"))
             (diagram (diagram-parse :sequence source))
             (rows (diagram-render diagram :width 100 :unicode t)))
        (ok (= 2 (length (sequence-participants diagram))))
        (ok (string= "Alice" (sequence-participant-label (first (sequence-participants diagram)))))
        (ok (= 3 (length (sequence-events diagram))))
        (ok (some (lambda (row) (search "hello" row)) rows))
        (ok (some (lambda (row) (search "reply" row)) rows))
        (ok (some (lambda (row) (search "self" row)) rows))
        (ok (> (length rows) 8)))
      (let* ((source (format nil "sequenceDiagram~%~A ->> is only a comment~%A->B: left~%Note left of A: note~%Note right of B: other~%Note over A,B: both~%loop outer~%alt first~%A->>B: nested~%else second~%opt inner~%B->A: reverse~%end~%end~%end" "%%"))
             (diagram (diagram-parse :sequence source))
             (rows (diagram-render diagram :width 100 :unicode nil)))
        (ok (= 2 (length (sequence-participants diagram))))
        (ok (= 13 (length (sequence-events diagram))))
        (ok (some (lambda (row) (search "outer" row)) rows))
        (ok (some (lambda (row) (search "second" row)) rows))
        (ok (some (lambda (row) (search "note" row)) rows))
        (ok (> (length rows) 12)))
      (let ((diagram (diagram-parse :sequence (format nil "sequenceDiagram~%participant one as 漢字~%participant two as é~%one->>two: 世界"))))
        (let ((rows (diagram-render diagram :width 80 :unicode t)))
          (ok (every (lambda (row) (<= (text-cell-width row) 80)) rows))
          (ok (some (lambda (row) (search "漢字" row)) rows))
          (ok (some (lambda (row) (search "世界" row)) rows))))
      (ok (signals 'invalid-diagram (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%A->")))))
      (ok (signals 'invalid-diagram (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%else")))))
      (ok (signals 'invalid-diagram (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%alt x~%else~%else~%end")))))
      (ok (signals 'invalid-diagram (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%loop x")))))
      (ok (signals 'unsupported-syntax (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%activate A")))))
      (ok (signals 'diagram-too-wide (lambda () (diagram-render (diagram-parse :sequence (format nil "sequenceDiagram~%A->>B: long")) :width 5))))
      (dolist (body '("A->>+B: activation" "A->>-B: deactivation"))
        (ok (signals 'unsupported-syntax
                     (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%~a" body))))))
      (dolist (body '("Note left of A,B: invalid" "Note over A,: invalid" "Note over A,B,C: invalid"))
        (ok (signals 'invalid-diagram
                     (lambda () (diagram-parse :sequence (format nil "sequenceDiagram~%~a" body))))))
      (let* ((source (format nil "sequenceDiagram~%participant A~%participant B~%participant C~%A->>B: forward~%B-->>A: reverse~%A->>A: self"))
             (rows (render-mermaid source :width 120 :unicode nil))
             (a (search "A" (second rows)))
             (b (search "B" (second rows)))
             (c (search "C" (second rows)))
             (forward (position-if (lambda (row) (search "forward" row)) rows))
             (reverse (position-if (lambda (row) (search "reverse" row)) rows))
             (self (position-if (lambda (row) (search "self" row)) rows)))
        (ok (every (lambda (row) (every (lambda (character) (< (char-code character) 128)) row)) rows))
        (ok (search ">>" (nth (1+ forward) rows) :start2 (1- b)))
        (ok (search "<<" (nth (1+ reverse) rows) :start2 a))
        (ok (every (lambda (row) (char= #\| (char row c))) (nthcdr 3 rows)))
        (ok (and (search "+" (nth (1+ self) rows) :start2 (+ a 4))
                 (char= #\| (char (nth (+ self 2) rows) (+ a 4)))
                 (search "<<" (nth (+ self 3) rows) :start2 a))))
      (ok (signals 'resource-limit-exceeded
                   (lambda () (let ((*maximum-source-length* 2))
                                (diagram-parse :sequence "sequenceDiagram")))))
      checks)))
